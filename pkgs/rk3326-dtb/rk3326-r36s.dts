// SPDX-License-Identifier: (GPL-2.0+ OR MIT)
/*
 * Copyright (c) 2024 Andre Renaud <andre@ignavus.net>
 * R36S device tree for mainline Linux kernel.
 * Uses ROCKNIX generic-dsi panel driver with NV3051D init sequence (ArkOS Panel 4).
 */

/dts-v1/;
#include <dt-bindings/gpio/gpio.h>
#include <dt-bindings/input/input.h>
#include <dt-bindings/leds/common.h>
#include <dt-bindings/pinctrl/rockchip.h>
#include "rk3326.dtsi"

/ {
	model = "R36S";
	compatible = "gamecon,r36s", "rockchip,rk3326";

	aliases {
		mmc0 = &sdmmc;
	};

	chosen {
		stdout-path = "serial2:1500000n8";
	};

	battery: battery {
		compatible = "simple-battery";
		charge-full-design-microamp-hours = <3000000>;
		charge-term-current-microamp = <300000>;
		constant-charge-current-max-microamp = <2000000>;
		constant-charge-voltage-max-microvolt = <4200000>;
		factory-internal-resistance-micro-ohms = <180000>;
		voltage-max-design-microvolt = <4100000>;
		voltage-min-design-microvolt = <3500000>;

		ocv-capacity-celsius = <20>;
		ocv-capacity-table-0 =  <4046950 100>, <4001920 95>, <3967900 90>, <3919950 85>,
					<3888450 80>, <3861850 75>, <3831540 70>, <3799130 65>,
					<3768190 60>, <3745650 55>, <3726610 50>, <3711630 45>,
					<3696720 40>, <3685660 35>, <3674950 30>, <3663050 25>,
					<3649470 20>, <3635260 15>, <3616920 10>, <3592440 5>,
					<3574170 0>;
	};

	backlight: backlight {
		compatible = "pwm-backlight";
		power-supply = <&vcc_bl>;
		pwms = <&pwm1 0 25000 0>;
	};

	builtin_gamepad: joypad {
		compatible = "rocknix-singleadc-joypad";
		pinctrl-names = "default";
		pinctrl-0 = <&btn_pins &mux_en_pins>;

		/* Device identity — RetroArch autoconfig matches on name + vendor/product */
		joypad-name = "r36s_Gamepad";
		joypad-vendor = <1>;
		joypad-product = <4488>;
		joypad-revision = <1>;

		/* ADC config */
		io-channel-names = "amux_adc";
		io-channels = <&saradc 1>;
		amux-count = <4>;
		amux-a-gpios = <&gpio3 RK_PB3 GPIO_ACTIVE_LOW>;
		amux-b-gpios = <&gpio3 RK_PB0 GPIO_ACTIVE_LOW>;
		amux-en-gpios = <&gpio3 RK_PB5 GPIO_ACTIVE_LOW>;

		/* ADC tuning */
		button-adc-scale = <2>;
		button-adc-deadzone = <64>;
		button-adc-fuzz = <32>;
		button-adc-flat = <32>;

		/* Per-axis tuning (percentage, 180 = 1.8x) */
		abs_x-p-tuning = <180>;
		abs_x-n-tuning = <180>;
		abs_y-p-tuning = <180>;
		abs_y-n-tuning = <180>;
		abs_rx-p-tuning = <180>;
		abs_rx-n-tuning = <180>;
		abs_ry-p-tuning = <180>;
		abs_ry-n-tuning = <180>;

		invert-absx;
		invert-absy;

		poll-interval = <16>;

		button-dpad-up {
			gpios = <&gpio1 RK_PB4 GPIO_ACTIVE_LOW>;
			label = "DPAD-UP";
			linux,code = <BTN_DPAD_UP>;
		};

		button-dpad-down {
			gpios = <&gpio1 RK_PB5 GPIO_ACTIVE_LOW>;
			label = "DPAD-DOWN";
			linux,code = <BTN_DPAD_DOWN>;
		};

		button-dpad-left {
			gpios = <&gpio1 RK_PB6 GPIO_ACTIVE_LOW>;
			label = "DPAD-LEFT";
			linux,code = <BTN_DPAD_LEFT>;
		};

		button-dpad-right {
			gpios = <&gpio1 RK_PB7 GPIO_ACTIVE_LOW>;
			label = "DPAD-RIGHT";
			linux,code = <BTN_DPAD_RIGHT>;
		};

		button-a {
			gpios = <&gpio1 RK_PA2 GPIO_ACTIVE_LOW>;
			label = "BTN-A";
			linux,code = <BTN_EAST>;
		};

		button-b {
			gpios = <&gpio1 RK_PA5 GPIO_ACTIVE_LOW>;
			label = "BTN-B";
			linux,code = <BTN_SOUTH>;
		};

		button-y {
			gpios = <&gpio1 RK_PA6 GPIO_ACTIVE_LOW>;
			label = "BTN-Y";
			linux,code = <BTN_WEST>;
		};

		button-x {
			gpios = <&gpio1 RK_PA7 GPIO_ACTIVE_LOW>;
			label = "BTN-X";
			linux,code = <BTN_NORTH>;
		};

		button-select {
			gpios = <&gpio3 RK_PB1 GPIO_ACTIVE_LOW>;
			label = "SELECT";
			linux,code = <BTN_SELECT>;
		};

		button-start {
			gpios = <&gpio3 RK_PB4 GPIO_ACTIVE_LOW>;
			label = "START";
			linux,code = <BTN_START>;
		};

		button-thumbl {
			gpios = <&gpio2 RK_PA2 GPIO_ACTIVE_LOW>;
			label = "THUMBL";
			linux,code = <BTN_THUMBL>;
		};

		button-thumbr {
			gpios = <&gpio2 RK_PA3 GPIO_ACTIVE_LOW>;
			label = "THUMBR";
			linux,code = <BTN_THUMBR>;
		};

		button-fn {
			gpios = <&gpio2 RK_PA4 GPIO_ACTIVE_LOW>;
			label = "FN";
			linux,code = <BTN_MODE>;
		};

		button-l1 {
			gpios = <&gpio2 RK_PA6 GPIO_ACTIVE_LOW>;
			label = "L1";
			linux,code = <BTN_TL>;
		};

		button-r1 {
			gpios = <&gpio2 RK_PA7 GPIO_ACTIVE_LOW>;
			label = "R1";
			linux,code = <BTN_TR>;
		};

		button-l2 {
			gpios = <&gpio3 RK_PB2 GPIO_ACTIVE_LOW>;
			label = "L2";
			linux,code = <BTN_TL2>;
		};

		button-r2 {
			gpios = <&gpio3 RK_PB7 GPIO_ACTIVE_LOW>;
			label = "R2";
			linux,code = <BTN_TR2>;
		};
	};

	volume_keys: gpio-keys-vol {
		compatible = "gpio-keys";
		pinctrl-names = "default";
		pinctrl-0 = <&vol_btn_pins>;

		button-volumeup {
			gpios = <&gpio2 RK_PA0 GPIO_ACTIVE_LOW>;
			label = "BTN-VOLUP";
			linux,code = <KEY_VOLUMEUP>;
		};

		button-volumedown {
			gpios = <&gpio2 RK_PA1 GPIO_ACTIVE_LOW>;
			label = "BTN-VOLDOWN";
			linux,code = <KEY_VOLUMEDOWN>;
		};
	};

	gpio_led: gpio-leds {
		compatible = "gpio-leds";
		pinctrl-names = "default";
		pinctrl-0 = <&led_pin>;

		led-0 {
			color = <LED_COLOR_ID_RED>;
			gpios = <&gpio2 RK_PB5 GPIO_ACTIVE_HIGH>;
			function = LED_FUNCTION_CHARGING;
		};
	};

	rk817-sound {
		compatible = "simple-audio-card";
		simple-audio-card,name = "rk817_int";
		simple-audio-card,format = "i2s";
		simple-audio-card,hp-det-gpio = <&gpio2 RK_PC6 GPIO_ACTIVE_HIGH>;
		simple-audio-card,mclk-fs = <256>;
		simple-audio-card,widgets =
			"Microphone", "Mic Jack",
			"Headphone", "Headphones",
			"Speaker", "Speaker";
		simple-audio-card,routing =
			"MICL", "Mic Jack",
			"Headphones", "HPOL",
			"Headphones", "HPOR",
			"Speaker", "SPKO";

		simple-audio-card,codec {
			sound-dai = <&rk817>;
		};

		simple-audio-card,cpu {
			sound-dai = <&i2s1_2ch>;
		};
	};

	vccsys: vccsys {
		compatible = "regulator-fixed";
		regulator-name = "vcc3v8_sys";
		regulator-always-on;
		regulator-min-microvolt = <3800000>;
		regulator-max-microvolt = <3800000>;
	};

	vcc_host: vcc_host {
		compatible = "regulator-fixed";
		regulator-name = "vcc_host";
		regulator-min-microvolt = <5000000>;
		regulator-max-microvolt = <5000000>;

		gpio = <&gpio0 RK_PB7 GPIO_ACTIVE_HIGH>;
		enable-active-high;
		regulator-always-on;
		regulator-boot-on;
		vin-supply = <&usb_midu>;
	};
};

&cpu0 {
	cpu-supply = <&vdd_arm>;
};

&cpu1 {
	cpu-supply = <&vdd_arm>;
};

&cpu2 {
	cpu-supply = <&vdd_arm>;
};

&cpu3 {
	cpu-supply = <&vdd_arm>;
};

&cru {
	assigned-clocks = <&cru PLL_NPLL>,
		<&cru ACLK_BUS_PRE>, <&cru ACLK_PERI_PRE>,
		<&cru HCLK_BUS_PRE>, <&cru HCLK_PERI_PRE>,
		<&cru PCLK_BUS_PRE>, <&cru SCLK_GPU>;

	assigned-clock-rates = <1188000000>,
		<200000000>, <200000000>,
		<150000000>, <150000000>,
		<100000000>, <200000000>;
};

&display_subsystem {
	status = "okay";
};

&dsi {
	status = "okay";

	ports {
		mipi_out: port@1 {
			reg = <1>;

			mipi_out_panel: endpoint {
				remote-endpoint = <&mipi_in_panel>;
			};
		};
	};

	internal_display: panel@0 {
		compatible = "rocknix,generic-dsi";
		iovcc-supply = <&vcc_lcd>;
		vdd-supply = <&vcc_lcd>;

		reg = <0>;
		backlight = <&backlight>;
		reset-gpios = <&gpio3 RK_PC0 GPIO_ACTIVE_LOW>;

		/* NV3051D panel - init sequence from ArkOS Panel 4 (60Hz) DTB */
		panel_description =
			"G size=52,70 delays=20,20,20,150,20 format=rgb888 lanes=4 flags=0xa03",

			"M clock=29000 horizontal=640,46,2,44 vertical=480,165,2,14 default=1",

			"I seq=ff30",
			"I seq=ff52",
			"I seq=ff01",
			"I seq=e300",
			"I seq=2510",
			"I seq=286f",
			"I seq=2901",
			"I seq=2adf",
			"I seq=2c22",
			"I seq=c30f",
			"I seq=379c",
			"I seq=38a7",
			"I seq=3941",
			"I seq=8020",
			"I seq=9167",
			"I seq=9267",
			"I seq=a055",
			"I seq=a150",
			"I seq=a358",
			"I seq=a49c",
			"I seq=a702",

			"I seq=b508",
			"I seq=b626",
			"I seq=b708",
			"I seq=b826",
			"I seq=2c22",
			"I seq=5c40",
			"I seq=c000",
			"I seq=c100",
			"I seq=c200",
			"I seq=ff30",
			"I seq=ff52",
			"I seq=ff02",
			"I seq=b002",
			"I seq=d002",
			"I seq=b10f",
			"I seq=d110",
			"I seq=b211",
			"I seq=d212",
			"I seq=b332",
			"I seq=d333",
			"I seq=b436",
			"I seq=d436",
			"I seq=b53c",
			"I seq=d53c",
			"I seq=b620",
			"I seq=d620",
			"I seq=b73e",
			"I seq=d73e",
			"I seq=b80e",
